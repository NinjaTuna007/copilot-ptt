<?xml version="1.0" encoding="utf-8"?>
<!-- Three screens, one shown at a time: the chat list (home), a chat, and settings. A messaging app's way: the list,
     then into a chat and back; your avatar on the list opens settings -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy"
    android:orientation="vertical">

<!-- Under the status bar: its height comes from the window's insets; the call's green during a call -->
<View
    android:id="@+id/statusSpace"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:background="@color/navy" />

<!-- While a call is up, on every screen: who it's with, how long, what is happening; speaker and hang-up.
     A tap goes back to the call's chat, a long press switches who it's with -->
<LinearLayout
    android:id="@+id/callBar"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@color/call_bar"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:visibility="gone">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp">

        <View
            android:id="@+id/callPulse"
            android:layout_width="40dp"
            android:layout_height="40dp" />

        <ImageView
            android:id="@+id/callAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/callName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Chronometer
                android:id="@+id/callTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/call_bar_sub"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/callStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/call_bar_sub"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- A photo, sent with what is said next: the camera opens, the call carries on -->
    <ImageButton
        android:id="@+id/callCamera"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="Take a photo for the agent"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_camera"
        android:tint="#FFFFFF" />

    <!-- Loudspeaker (a light circle) or the earpiece (dimmer, no circle), as a phone call's speaker button -->
    <ImageButton
        android:id="@+id/speaker"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="Speaker"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_sound"
        android:tint="#FFFFFF" />

    <ImageButton
        android:id="@+id/callBarHang"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="@android:color/transparent"
        android:contentDescription="Hang up"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/hang_small" />
</LinearLayout>

<FrameLayout
    android:id="@+id/screens"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:background="@color/navy">

    <!-- The chat list: your crew, newest first; pull down to look for every agent running -->
    <LinearLayout
        android:id="@+id/listScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/navy"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Henchline"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- How the chats are ordered: tap to cycle (recent, by project, by agent) -->
            <TextView
                android:id="@+id/sort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/pill"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Recent"
                android:textColor="@color/cyan"
                android:textSize="13sp" />

            <!-- Settings has its own button: a tap on you sets Away (the design review, 2026-11-17) -->
            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:src="@android:drawable/ic_menu_preferences"
                android:tint="@color/muted" />

            <!-- You: a tap goes Away (headset off) or back; a long press opens Settings. The dot says which -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <ImageButton
                    android:id="@+id/profile"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="You: tap to go away or come back, hold for settings"
                    android:scaleType="fitCenter"
                    android:src="@drawable/avatar_you" />

                <View
                    android:id="@+id/presence"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="bottom|end" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/awayLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-10dp"
            android:paddingHorizontal="20dp"
            android:paddingBottom="8dp"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Search: project and agent names first, then what was said in the chats -->
        <EditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/pill"
            android:hint="Search chats"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingHorizontal="18dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:id="@+id/crew"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="88dp"
                        android:orientation="vertical" />
                </ScrollView>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!-- New chat: start an agent on the laptop in a folder it already trusts (as a messaging app's new chat) -->
            <ImageButton
                android:id="@+id/compose"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="18dp"
                android:background="@drawable/squircle"
                android:contentDescription="New chat: start an agent"
                android:elevation="6dp"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_launcher_foreground" />
        </FrameLayout>

        <!-- Chats, Calls and Usage, as a messaging app's bottom bar (the user's wishes, 2026-11-16 and -17) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/surface"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabUsage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:text="📊  Usage"
                android:textColor="@color/muted"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabChats"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:text="💬  Chats"
                android:textColor="@color/cyan"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabCalls"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:text="📞  Calls"
                android:textColor="@color/muted"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>

    <!-- A chat -->
    <LinearLayout
        android:id="@+id/chatScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/navy"
        android:orientation="vertical"
        android:visibility="gone">


        <!-- Who you are talking to: their henchman, their name, what is happening; and the call button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="10dp">

            <ImageButton
                android:id="@+id/menu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back to your chats"
                android:src="@drawable/ic_back"
                android:tint="@color/text" />

            <ImageView
                android:id="@+id/avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/avatar_handsfree" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/who"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Henchline"
                    android:textColor="@color/text"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Not on a call"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/call"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/round_call"
                android:contentDescription="Call"
                android:src="@drawable/ic_phone"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/chatAway"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="6dp"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/planBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/chatTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Chat"
                android:textColor="@color/cyan"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/planTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Plan"
                android:textColor="@color/muted"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/chatScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="12dp">

                <LinearLayout
                    android:id="@+id/chat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="8dp" />
            </ScrollView>

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/planRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <ScrollView
                    android:id="@+id/planScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="16dp">

                    <LinearLayout
                        android:id="@+id/planList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="24dp" />
                </ScrollView>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_gravity="top"
                android:background="@drawable/fade_top" />

            <!-- Not on a call: just the henchman and how to call -->
            <LinearLayout
                android:id="@+id/idle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/avatar_handsfree" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:text="Tap the green button to call your crew"
                    android:textColor="@color/muted"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Hold to talk; tap for the open line off (noisy places) or on -->
        <Button
            android:id="@+id/talk"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="8dp"
            android:enabled="false"
            android:text="Hold\nto talk"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <!-- Replying to a message (swipe it right): shown above the box, sent with the answer; the cross (or a tap
             anywhere on it) stops replying -->
        <TextView
            android:id="@+id/quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/pill"
            android:drawableEnd="@drawable/ic_close"
            android:drawablePadding="10dp"
            android:drawableTint="@color/muted"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/inputRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/compose_box"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp">

            <EditText
                android:id="@+id/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:enabled="false"
                android:gravity="top|start"
                android:hint="Message your crew…"
                android:imeOptions="actionNone"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="6"
                android:minHeight="48dp"
                android:minLines="1"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:scrollbars="vertical"
                android:textColor="@color/text"
                android:textColorHint="@color/muted" />

            <!-- The model and plan sit on their own row. A long model name used to push Send off the screen
                 once Stop appeared. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/modelChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="200dp"
                    android:background="@drawable/chip"
                    android:contentDescription="The agent's model: tap to switch"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="✦ Model"
                    android:textColor="@color/text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/planChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/chip"
                    android:contentDescription="Plan mode: tap to turn it on or off"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="Plan"
                    android:textColor="@color/muted"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Add, stop, and send stay on the row a thumb can reach. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/attach"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Add a photo, a picture or files"
                    android:enabled="false"
                    android:src="@drawable/ic_add"
                    android:tint="@color/text" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- While the agent works on what you sent: stop it, as Escape in its terminal -->
                <ImageButton
                    android:id="@+id/stop"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/round_call"
                    android:backgroundTint="@color/surface_high"
                    android:contentDescription="Stop the agent"
                    android:src="@drawable/ic_stop"
                    android:tint="@color/text"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/send"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/round_call"
                    android:backgroundTint="@color/cyan"
                    android:contentDescription="Send"
                    android:enabled="false"
                    android:src="@drawable/ic_send"
                    android:tint="@color/navy" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Settings: you, the sound, the laptop's address -->
    <ScrollView
        android:id="@+id/settingsScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/navy"
        android:fillViewport="true"
        android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="20dp">

            <ImageButton
                android:id="@+id/settingsBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back to your chats"
                android:src="@drawable/ic_back"
                android:tint="@color/text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Settings"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- You: the boss -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="24dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:importantForAccessibility="no"
                android:src="@drawable/avatar_you" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/myName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:text="Boss"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap your name to change it"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/soundRow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sound"
                android:tint="@color/muted" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="Clear sound for new calls"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Clear sound: media audio instead of the phone-call path" />
        </LinearLayout>

        <!-- Agents' thinking as thought bubbles in their chats (Cursor IDE chats keep it) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Show agents' thinking"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/thoughtsSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Show agents' thinking as thought bubbles" />
        </LinearLayout>

        <!-- While an agent's tool runs: its avatar dancing at the bottom of the chat, or a turning gear -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Animated henchmen"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/danceSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Agents' avatars dance while a tool runs; off: a turning gear" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/serverRow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_link"
                android:tint="@color/muted" />

            <TextView
                android:id="@+id/server"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="Set the laptop's address"
                android:textColor="@color/text"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</FrameLayout>
</LinearLayout>
